<Window x:Class="GenericCardLogon.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GenericCardLogon セットアップ"
        Width="900" Height="600" MinWidth="820" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        WindowStyle="None" AllowsTransparency="True">
    <Border Background="{StaticResource BgBrush}" CornerRadius="18" BorderBrush="#24304A" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="92"/><RowDefinition Height="*"/><RowDefinition Height="76"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="30,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="GenericCardLogon" FontSize="25" FontWeight="SemiBold"/>
                    <TextBlock Text="FeliCa カードログオン セットアップ" FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Content="×" Width="42" Height="36" HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" Click="Close_Click" FontSize="22" Padding="0"/>
            </Grid>
            <Grid Grid.Row="1" Margin="30,8,30,20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="26"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="28">
                    <StackPanel>
                        <TextBlock Text="FeliCa で Windows にログイン" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="RC-S380 と FeliCa IDm を使った認証環境を、このPCにセットアップします。" Foreground="{StaticResource MutedBrush}" FontSize="15" TextWrapping="Wrap" Margin="0,14,0,24"/>
                        <Border Background="{StaticResource Panel2Brush}" CornerRadius="12" Padding="18" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="✓ LocalSystem Service" FontSize="14" Margin="0,0,0,8"/>
                                <TextBlock Text="✓ Windows Credential Provider" FontSize="14" Margin="0,0,0,8"/>
                                <TextBlock Text="✓ Manager / カード登録" FontSize="14" Margin="0,0,0,8"/>
                                <TextBlock Text="✓ 通常のWindowsログオンも維持" FontSize="14"/>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="StatusText" Text="準備完了" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="24">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="セットアップ" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="管理者権限が必要です。" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,22"/>
                        <Button x:Name="InstallButton" Content="インストール / 修復" Style="{StaticResource PrimaryButton}" Click="Install_Click" Margin="0,0,0,12"/>
                        <Button Content="Managerを起動" Click="LaunchManager_Click" Margin="0,0,0,12"/>
                        <Button Content="アンインストール" Click="Uninstall_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
            <Grid Grid.Row="2" Background="#0E1527" Margin="0,0,0,0">
                <TextBlock Text="GenericCardLogon v9.5 • LSA Authentication Package は使用しません" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="30,0"/>
            </Grid>
        </Grid>
    </Border>
</Window>
