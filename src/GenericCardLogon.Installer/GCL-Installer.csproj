<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>GenericCardLogon.Installer</RootNamespace>
    <AssemblyName>GCL-Installer</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>GenericCardLogon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\bin\AnyCPU\Release\net48\GenericCardLogon.Core.dll" LogicalName="Payload.GenericCardLogon.Core.dll" />
    <EmbeddedResource Include="..\..\bin\AnyCPU\Release\net48\GenericCardLogon.Service.exe" LogicalName="Payload.GenericCardLogon.Service.exe" />
    <EmbeddedResource Include="..\..\bin\AnyCPU\Release\net48\GenericCardLogon.Service.exe.config" LogicalName="Payload.GenericCardLogon.Service.exe.config" />
    <EmbeddedResource Include="..\..\bin\AnyCPU\Release\net48\PCSC.dll" LogicalName="Payload.PCSC.dll" />
    <EmbeddedResource Include="..\..\bin\AnyCPU\Release\net48\PCSC.Iso7816.dll" LogicalName="Payload.PCSC.Iso7816.dll" />
    <EmbeddedResource Include="..\..\bin\AnyCPU\Release\net48\GenericCardLogon.Manager.exe" LogicalName="Payload.GenericCardLogon.Manager.exe" />
    <EmbeddedResource Include="..\..\bin\AnyCPU\Release\net48\GenericCardLogon.Manager.exe.config" LogicalName="Payload.GenericCardLogon.Manager.exe.config" />
    <EmbeddedResource Include="..\..\bin\x64\Release\GenericCardLogon.CredentialProvider.dll" LogicalName="Payload.GenericCardLogon.CredentialProvider.dll" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="GenericCardLogon.ico" />
  </ItemGroup>
</Project>
