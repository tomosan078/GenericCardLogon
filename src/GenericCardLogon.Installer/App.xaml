<Application x:Class="GenericCardLogon.Installer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="BgBrush" Color="#0B1020"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#121A2B"/>
        <SolidColorBrush x:Key="Panel2Brush" Color="#182238"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#5B8CFF"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F7F9FC"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#9AA7BD"/>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F7F9FC"/>
            <Setter Property="Background" Value="#25314D"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#5B8CFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="26,13"/>
        </Style>
    </Application.Resources>
</Application>
